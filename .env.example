# ---------------------------------------------------------------------------
# Backend (FastAPI + SQLite)
# ---------------------------------------------------------------------------

# Optional: override where the SQLite database file lives.
# Defaults to backend/hospital.db
# HOSPITAL_DB_PATH=C:/path/to/hospital.db

# Optional: full SQLAlchemy URL. Overrides HOSPITAL_DB_PATH when set.
# DATABASE_URL=sqlite:///C:/path/to/hospital.db

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------

# Base URL of the local FastAPI backend (used by the React app).
VITE_API_URL=http://127.0.0.1:8000

# Optional: where the Electron shell loads the dev server in development.
# VITE_DEV_SERVER_URL=http://127.0.0.1:5173
